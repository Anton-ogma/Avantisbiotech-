# Скопируйте в .env рядом с docker-compose.yml и заполните. Значений по умолчанию
# у секретов НЕТ намеренно: `docker compose up` откажется стартовать, пока они не
# заданы. Развёртывание, молча поднявшееся с паролем `diers`, — открытая база.

# ── Секреты (обязательны) ─────────────────────────────────────────────────────
# openssl rand -hex 32
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
# Общий секрет с хостом: им подтверждается, что вызов пришёл от хоста, а не от
# того, кто увидел порт. Роль и актор приходят заголовками, и без секрета их
# назначает себе кто угодно. Не короче 32 символов — иначе старт не пройдёт.
DIERS_GATEWAY_TOKEN=

# ── Регуляторная граница (Р-25) ───────────────────────────────────────────────
# clinical без номера РУ и без секрета хоста не стартует.
DIERS_INTENDED_USE=research
# DIERS_REGISTRATION_NUMBER=РЗН-2026-XXXXX

# ── Хранилище ─────────────────────────────────────────────────────────────────
DIERS_DATABASE_URL=postgresql+asyncpg://diers:ЗАПОЛНИТЕ@pgbouncer:5432/diers
DIERS_REDIS_URL=redis://redis:6379/0
DIERS_S3_ENDPOINT=http://minio:9000

# ── Пять версий конфигурации — входят в input_hash (Р-3) ──────────────────────
DIERS_REGISTRY_VERSION=2026.7
DIERS_PROFILE_VERSION=2026.7
DIERS_THRESHOLDS_VERSION=demo-2026.7
DIERS_NORMS_VERSION=empty
DIERS_PROTOCOL_VERSION=2026.1

# ── Приём файлов ──────────────────────────────────────────────────────────────
# Должен совпадать с MAX_UPLOAD_MB у веб-контейнера: иначе nginx отвергнет
# выгрузку раньше, чем её увидит модуль, и причина отказа будет невнятной.
DIERS_MAX_UPLOAD_MB=32

# ── Замкнутость контура (Р-23): ФЗ-152 ст. 18 ч. 5 и ст. 12 ────────────────────
# Внешний хост в llm_endpoint приведёт к отказу старта.
DIERS_ALLOW_EXTERNAL_CALLS=false
# DIERS_LLM_ENDPOINT=http://localhost:11434/v1
